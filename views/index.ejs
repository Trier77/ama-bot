<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <title>Document</title>
</head>
  <body>
    <main>
      <h1>AMA</h1>
      <section class="form">
        <h2>Spørg om hvad som helst</h2>
        <form action="/ask" method="post">
        <label for="question">Skriv dit spørgsmål her:</label>
        <input id="question" name="question" type="text"></input>
        <button type="submit">Spørg</button>
        </form>

        <% if (question) { %>
        <article class="question">
          <p><%= question %></p>
        </article>
        <% } %>
        </section>
      
      
    </main>
    
  </body>
</html>