<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <title>Document</title>
</head>
  <body>
    <main>
      <h1>AMA</h1>
      <section class="form">
        <h2>Spørg om hvad som helst</h2>
        <form action="/ask" method="post">
        <label for="question">Skriv dit spørgsmål her:</label>
        <input id="question" name="question" type="text"></input>
        <button type="submit">Spørg</button>
        </form>
        <form action="/clear-messages" method="POST">
          <button type="submit">Ryd beskeder</button>
        </form>
      </section>
        
      <section class="messages">
        <% for (const message of messages) { %>
          <article class="<%= message.type %>">
            <p><%= message.text %></p>
            <time><%= message.createdAt.toLocaleTimeString("da-DK") %></time>
          </article>
        <% } %>

        <% if (error) { %>
          <p role="alert"><%= error %></p>
        <% } %>
        </article>
      </section>
        
        
        
      
      
    </main>
    
  </body>
</html>